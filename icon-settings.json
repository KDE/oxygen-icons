{
  "version": 1,
  "title": "Configure Oxygen Icons",
  "description": "Choose which Oxygen symbolic artwork sizes to include for Plasma widgets (plasmoids), such as those in the system tray. These options control artwork availability, not whether a widget requests symbolic icons. ",
  "pages": [
    {
      "title": "Plasma Widgets",
      "controls": [
        {
          "id": "symbolic16",
          "type": "checkbox",
          "label": "Include 16 px symbolic artwork",
          "default": true
        },
        {
          "id": "symbolic22",
          "type": "checkbox",
          "label": "Include 22 px symbolic artwork",
          "default": true
        },
        {
          "id": "symbolic24",
          "type": "checkbox",
          "label": "Include 24 px symbolic artwork",
          "default": true
        },
        {
          "id": "symbolic32",
          "type": "checkbox",
          "label": "Include 32 px symbolic artwork",
          "default": true
        }
      ]
    },
    {
      "title": "Action Icons",
      "controls": [
        {
          "id": "symbolicActions16",
          "type": "checkbox",
          "label": "Replace 16 px action icons with symbolic icons",
          "default": false
        },
        {
          "id": "symbolicActions22",
          "type": "checkbox",
          "label": "Replace 22 px action icons with symbolic icons",
          "default": false
        },
        {
          "id": "symbolicActions32",
          "type": "checkbox",
          "label": "Replace 32 px action icons with symbolic icons",
          "default": false
        },
        {
          "id": "symbolicActions64",
          "type": "checkbox",
          "label": "Replace 64 px action icons with symbolic icons",
          "default": false
        }
      ]
    }
  ],
  "installation": {
        "type": "userThemeCopy",
        "rules": [
          {
            "when": {"control": "symbolic16", "equals": false},
            "operation": {"type": "omitDirectories", "directories": ["applets/16x16"]}
          },
          {
            "when": {"control": "symbolic22", "equals": false},
            "operation": {"type": "omitDirectories", "directories": ["applets/22x22"]}
          },
          {
            "when": {"control": "symbolic24", "equals": false},
            "operation": {"type": "omitDirectories", "directories": ["applets/24x24"]}
          },
          {
            "when": {"control": "symbolic32", "equals": false},
            "operation": {"type": "omitDirectories", "directories": ["applets/32x32"]}
          },
          {
            "when": {"control": "symbolicActions16", "equals": false},
            "operation": {"type": "omitDirectories", "directories": ["simbolicActions/16x16/actions"]}
          },
          {
            "when": {"control": "symbolicActions16", "equals": true},
            "operation": {"type": "omitDirectories", "directories": ["16x16/actions"]}
          },
          {
            "when": {"control": "symbolicActions22", "equals": false},
            "operation": {"type": "omitDirectories", "directories": ["simbolicActions/22x22/actions"]}
          },
          {
            "when": {"control": "symbolicActions22", "equals": true},
            "operation": {"type": "omitDirectories", "directories": ["22x22/actions"]}
          },
          {
            "when": {"control": "symbolicActions32", "equals": false},
            "operation": {"type": "omitDirectories", "directories": ["simbolicActions/32x32/actions"]}
          },
          {
            "when": {"control": "symbolicActions32", "equals": true},
            "operation": {"type": "omitDirectories", "directories": ["32x32/actions"]}
          },
          {
            "when": {"control": "symbolicActions64", "equals": false},
            "operation": {"type": "omitDirectories", "directories": ["simbolicActions/64x64/actions"]}
          },
          {
            "when": {"control": "symbolicActions64", "equals": true},
            "operation": {"type": "omitDirectories", "directories": ["64x64/actions"]}
          }
        ]
  }
}
